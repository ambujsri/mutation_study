# Any folder whose name starts with "." (tool caches, virtualenvs, IDE settings:
# .mypy_cache/, .pytest_cache/, .ruff_cache/, .venv/, .vscode/, .idea/, ...)
.*/

# Python build artefacts
__pycache__/
*.pyc

# OS files
.DS_Store




# Generated artefacts (regenerated by the pipeline; folders kept via .gitkeep)
data/processed/*
results/models/*
results/metrics/*
results/figures/*
results/mutation_rankings/*
!**/.gitkeep
